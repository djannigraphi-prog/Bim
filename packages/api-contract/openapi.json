  "info": {
    "title": "API BIM",
    "description": "API de l’application BIM (Beauté, Image, Motivation). Erreurs au format { error: { code, message, details } } — voir docs/API_ERRORS.md.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "Doho Yannick"
          },
          "username": {
            "type": "string",
            "example": "yannick.doho",
            "description": "Sans « @ » ; 3 à 30 caractères : lettres, chiffres, point, tiret bas"
          },
          "birthDate": {
            "type": "string",
            "example": "1998-03-12",
            "description": "AAAA-MM-JJ ; privée par défaut"
          },
          "city": {
            "type": "string",
            "example": "Cocody"
          },
          "phone": {
            "type": "string",
            "example": "+2250700000000",
            "description": "Téléphone ou e-mail : au moins un des deux (F16)"
          },
          "email": {
            "type": "string",
            "example": "nom@exemple.com"
          },
          "gender": {
            "type": "string",
            "enum": [
              "female",
              "male",
              "undisclosed"
            ]
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "interests": {
            "example": [
              "mode",
              "sport_coaching",
              "coiffure"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "fullName",
          "username",
          "birthDate",
          "city",
          "password",
          "interests"
        ]
      },
      "VerifyCodeDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "deviceName": {
            "type": "string",
            "example": "iPhone de Yannick"
          }
        },
        "required": [
          "challengeId",
          "code"
        ]
      },
      "ChallengeRefDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "challengeId"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "yannick.doho",
            "description": "E-mail, téléphone ou nom d’utilisateur"
          },
          "password": {
            "type": "string"
          },
          "deviceName": {
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "description": "E-mail, téléphone ou nom d’utilisateur"
          }
        },
        "required": [
          "identifier"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "code",
          "newPassword"
        ]
      },
      "StepUpStartDto": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "contact_change",
              "password_change",
              "account_deletion",
              "withdrawal"
            ]
          },
          "password": {
            "type": "string",
            "description": "Obligatoire si le compte a un mot de passe"
          }
        },
        "required": [
          "scope"
        ]
      },
      "SwitchSpaceDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "user",
              "merchant",
              "courier"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "id"
        ]
      },
      "UpdatePreferencesDto": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          }
        }
      },
      "AddContactDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "newPassword"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "eco",
              "premium"
            ],
            "description": "Écran 19. Projet économique (solutions gratuites) ou Premium (recommandations d’achats). Choix gratuit, ouvert à tous, indépendant de l’abonnement Premium (C6)."
          },
          "budget": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "boosted"
            ],
            "description": "Mode Premium uniquement ; indicatif, aucun paiement (F4)"
          },
          "categoryCode": {
            "type": "string",
            "example": "sport",
            "description": "Écran 20"
          },
          "goalCode": {
            "type": "string",
            "example": "sport_perte_poids",
            "description": "Écran 21"
          },
          "targetQuantity": {
            "type": "number",
            "example": 10,
            "description": "Quantité (ex. kilos) si l’objectif en a une"
          },
          "description": {
            "type": "string",
            "example": "Perdre du ventre avant mon mariage en décembre"
          },
          "receiveMerchantOffers": {
            "type": "boolean",
            "default": false,
            "description": "Enregistré ; les offres arrivent avec le lot 5"
          },
          "heightCm": {
            "type": "number",
            "example": 172
          },
          "weightKg": {
            "type": "number",
            "example": 84
          },
          "level": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "morning",
              "noon",
              "afternoon"
            ]
          },
          "sessionsPerWeek": {
            "type": "number",
            "example": 3
          },
          "healthNote": {
            "type": "string",
            "example": "Douleur au genou",
            "description": "Privé ; BIM ne donne aucun avis médical"
          },
          "durationDays": {
            "type": "number",
            "example": 60,
            "description": "Si aucun modèle validé n’existe : une des durées de projects.durations_days"
          },
          "isPublic": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "mode",
          "categoryCode"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "isPublic": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "eco",
              "premium"
            ],
            "description": "Changer de mode (écran 19 : « Tu pourras changer de mode plus tard ») ; gratuit, sans lien avec l’abonnement (C6)"
          },
          "budget": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "boosted"
            ],
            "description": "Obligatoire si le mode devient Premium"
          }
        }
      },
      "AddTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Étirements"
          },
          "detail": {
            "type": "string",
            "example": "15 min"
          },
          "timeOfDay": {
            "type": "string",
            "example": "21:00"
          },
          "weekdays": {
            "type": "number",
            "example": 127,
            "description": "Jours : bit 0 = lundi … bit 6 = dimanche ; 127 = tous les jours"
          }
        },
        "required": [
          "title",
          "timeOfDay",
          "weekdays"
        ]
      },
      "PauseDto": {
        "type": "object",
        "properties": {
          "days": {
            "type": "number",
            "example": 3,
            "description": "Écran 29 : 1 jour, 3 jours, 1 semaine ou autre"
          }
        },
        "required": [
          "days"
        ]
      }
    }
  }
}
