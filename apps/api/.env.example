# Exemple de configuration de l'API BIM pour le DÉVELOPPEMENT LOCAL.
# Copier en .env (jamais commité). Les valeurs de staging/production vivent dans AWS Secrets Manager.
# Documentation complète : docs/ENVIRONMENT.md
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:5173
HTTP_THROTTLE_ENABLED=true

DATABASE_URL=postgres://bim:bim@localhost:5432/bim_dev
DATABASE_POOL_MAX=10

# Générer avec : openssl rand -base64 48   (deux valeurs différentes)
JWT_ACCESS_SECRET=remplacer-par-une-valeur-aleatoire-de-48-caracteres-min
OTP_SECRET=remplacer-par-une-autre-valeur-aleatoire-de-48-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
STEP_UP_TTL_SECONDS=300
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_DESTINATION_PER_HOUR=6

# console = le code s'affiche dans les journaux (développement uniquement ; refusé en staging/production)
SMS_PROVIDER=console
EMAIL_PROVIDER=console

# Connexions sociales : laisser vide tant qu'elles ne sont pas intégrées
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
FACEBOOK_APP_ID=

DEFAULT_PHONE_REGION=CI

# Administration : clé de chiffrement des secrets de double authentification (32 octets en base64).
# Générer avec : openssl rand -base64 32
# Valeur ci-dessous valable pour le développement local SEULEMENT (32 octets connus de tous).
ADMIN_TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktYWRtaW4tdG90cC1rZXktMzJieXRlcyE=
# Lot 5 : chiffrement des pièces d'identité des marchands (32 octets en base64, différente de la clé ci-dessus).
# Sans elle, l'ouverture des boutiques répond « non configurée ». Générer avec : openssl rand -base64 32
# KYC_ENCRYPTION_KEY=
ADMIN_SESSION_TTL_MINUTES=480
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOCK_MINUTES=15
